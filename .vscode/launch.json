    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Module",
            "type": "debugpy",
            "request": "launch",
            "module": "src.exercise_01.${fileBasenameNoExtension}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "exercise_02.dataset",
            "type": "debugpy",
            "request": "launch",
            "module": "src.exercise_02.dataset",
            "console": "integratedTerminal"
        },
        {
            "name": "exercise_02.train",
            "type": "debugpy",
            "request": "launch",
            "module": "src.exercise_02.train",
            "console": "integratedTerminal"
        },
        {
            "name": "exercise_02.model",
            "type": "debugpy",
            "request": "launch",
            "module": "src.exercise_02.model",
            "console": "integratedTerminal"
        },
        {
            "name": "exercise_02.evaluate",
            "type": "debugpy",
            "request": "launch",
            "module": "src.exercise_02.evaluate",
            "console": "integratedTerminal"
        },
        {
            "name": "exercise_02: Full Pipeline Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/exercise_02/run_pipeline.py",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "exercise_02: Full Pipeline (Sequential)",
            "configurations": [
                "exercise_02: Full Pipeline Script"
            ]
        }
    ]
